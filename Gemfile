# frozen_string_literal: true

source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "jekyll-feed", "~> 0.15"
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-seo-tag", "~> 2.8"

# Unbundled from the Ruby stdlib in 3.0+ / 3.4+; Jekyll still needs them.
gem "webrick", "~> 1.8"
gem "csv", "~> 3.3"
gem "base64", "~> 0.2"
gem "logger", "~> 1.6"

# Windows: event-driven file watching for `jekyll serve` instead of polling.
gem "wdm", "~> 0.2", install_if: -> { Gem.win_platform? }

